APP_NAME="QPOS Mobile Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOURDOMAIN.com
# IMPORTANT: do NOT add /public at the end.
# Wrong:  https://YOURDOMAIN.com/public
# Right:  https://YOURDOMAIN.com

# Demo login tiles on login page — keep false on live
SHOW_DEMO_SHOPS=false

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=mail.YOURDOMAIN.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@YOURDOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional — leave blank if unused
GEMINI_API_KEY=
